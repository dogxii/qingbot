{
  "name": "qingbot",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight QQ official bot framework with a simple plugin layer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogxii/qingbot.git"
  },
  "bugs": {
    "url": "https://github.com/dogxii/qingbot/issues"
  },
  "homepage": "https://github.com/dogxii/qingbot#readme",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "check": "npm run typecheck && npm run build",
    "build": "node scripts/clean-dist.mjs && tsc && tsc-alias && node scripts/copy-plugin-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "node-cron": "^4.6.0",
    "qq-official-bot": "^1.3.0"
  },
  "overrides": {
    "axios": "$axios"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "qq-bot",
    "qq-official-bot",
    "bot",
    "plugin",
    "typescript"
  ],
  "author": "dogxii",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "commonjs"
}
